{
  "name": "actex",
  "type": "module",
  "version": "0.0.0",
  "description": "Typed sequence executor for business processes.",
  "author": "aidanhibbard",
  "license": "MIT",
  "homepage": "https://github.com/aidanhibbard/actex#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aidanhibbard/actex.git"
  },
  "bugs": {
    "url": "https://github.com/aidanhibbard/actex/issues"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p docs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "release": "bumpp",
    "prepublishOnly": "pnpm run build",
    "vp:dev": "vitepress dev docs",
    "vp:build": "vitepress build docs",
    "vp:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^1.2.0",
    "@eslint/markdown": "^8.0.2",
    "@types/node": "^25.6.2",
    "@typescript/native-preview": "7.0.0-dev.20260509.2",
    "@vitest/coverage-v8": "^4.1.5",
    "bumpp": "^11.1.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.1",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.6.0",
    "prettier": "3.8.3",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vitepress": "^2.0.0-alpha.17",
    "vitest": "^4.1.5",
    "zod": "^4.0.0"
  }
}